datasource db {
  provider = "sqlite"
  url      = "file:./campus.db"
}

generator client {
  provider = "prisma-client-js"
}

// User model for One Identity
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String?
  name           String
  role           String    // Student, Warden, Admin, Faculty, Staff
  department     String?
  year           Int?
  branch         String?
  isResident     Boolean   @default(false)
  hostel         String?
  block          String?
  room           String?

  // Relationships
  requestsCreated Request[] @relation("RequestCreator")
  requestsAssigned Request[] @relation("RequestAssignee")
  auditLogs       AuditLog[]
  scholarship     Scholarship?
  notifications   Notification[]
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  announcementReceipts AnnouncementReceipt[]
}

model Request {
  id                 String    @id @default(uuid())
  ticketNumber       String    @unique
  requestType        String    // COMPLAINT, LEAVE, CERTIFICATE, etc.
  category           String
  requesterId        String
  requester          User      @relation("RequestCreator", fields: [requesterId], references: [id])
  description        String
  location           String?
  priority           String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status             String    @default("PENDING") // PENDING, ASSIGNED, ACKNOWLEDGED, PROCESSING, RESOLVED, VERIFIED, CLOSED, REJECTED
  assignedDepartment String?
  assignedAuthorityId String?
  assignedAuthority  User?     @relation("RequestAssignee", fields: [assignedAuthorityId], references: [id])
  SLA                Int?      // Hours
  dueAt              DateTime?
  incidentId         String?
  incident           Incident? @relation(fields: [incidentId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  exitTime           DateTime? // for leave/gate-pass metadata
  metadata           String?   // JSON string for attachments, custom fields, etc.
  escalations        Escalation[]
}

model Incident {
  id                 String    @id @default(uuid())
  title              String
  description        String
  category           String
  location           String
  status             String    @default("OPEN")
  assignedDepartment String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  
  requests           Request[]
}

model Scholarship {
  id                 String    @id @default(uuid())
  studentId          String    @unique
  student            User      @relation(fields: [studentId], references: [id])
  academicYear       String
  status             String    // ELIGIBLE, APPLIED, SUBMITTED, UNDER_VERIFICATION, APPROVED, SANCTIONED, DISBURSED, REJECTED, CANCELLED
  updatedAt          DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String
  entity      String
  entityId    String
  timestamp   DateTime @default(now())
  metadata    String?  // JSON string
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id])
  title       String
  message     String
  type        String    // e.g., 'REQUEST_UPDATE', 'SYSTEM_ALERT'
  readAt      DateTime? // null indicates unread
  metadata    String?   // JSON string
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
}

model Escalation {
  id        String   @id @default(uuid())
  requestId String
  level     Int      @default(1)
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id])

  @@unique([requestId, level])
  @@index([requestId, createdAt])
}

model Announcement {
  id             String    @id @default(uuid())
  title          String
  body           String
  createdById    String
  creator        User      @relation("AnnouncementCreator", fields: [createdById], references: [id])
  targetBranch   String?
  targetYear     Int?
  targetHostel   String?
  targetBlock    String?
  requiresAck    Boolean   @default(false)
  priority       String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  createdAt      DateTime  @default(now())

  receipts       AnnouncementReceipt[]
}

model AnnouncementReceipt {
  id             String    @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  deliveredAt    DateTime  @default(now())
  readAt         DateTime?
  acknowledgedAt DateTime?

  @@unique([announcementId, userId])
  @@index([userId])
}

