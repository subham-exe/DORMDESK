generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./campus.db"
}

model Announcement {
  id           String                @id @default(uuid())
  title        String
  body         String
  createdById  String
  targetBranch String?
  targetYear   Int?
  targetHostel String?
  targetBlock  String?
  requiresAck  Boolean               @default(false)
  priority     String                @default("LOW")
  createdAt    DateTime              @default(now())
  creator      User                  @relation("AnnouncementCreator", fields: [createdById], references: [id])
  receipts     AnnouncementReceipt[]
}

model AnnouncementReceipt {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  deliveredAt    DateTime     @default(now())
  readAt         DateTime?
  acknowledgedAt DateTime?
  user           User         @relation(fields: [userId], references: [id])
  announcement   Announcement @relation(fields: [announcementId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId])
}

model Attendance {
  id        String       @id @default(uuid())
  sessionId String
  studentId String
  status    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  student   User         @relation(fields: [studentId], references: [id])
  session   ClassSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, studentId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entity     String
  entityId   String
  timestamp  DateTime @default(now())
  metadata   String?
  actorEmail String?
  actorName  String?
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([timestamp])
  @@index([entity, entityId, timestamp])
}

model ClassSession {
  id                 String       @id @default(uuid())
  courseId           String
  scheduledAt        DateTime
  status             String       @default("SCHEDULED")
  cancellationReason String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  attendances        Attendance[]
  course             Course       @relation(fields: [courseId], references: [id])
}

model Course {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  facultyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sessions    ClassSession[]
  user        User           @relation(fields: [facultyId], references: [id])
  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(uuid())
  courseId  String
  studentId String
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([courseId, studentId])
}

model Escalation {
  id        String   @id @default(uuid())
  requestId String
  level     Int      @default(1)
  createdAt DateTime @default(now())
  request   Request  @relation(fields: [requestId], references: [id])

  @@unique([requestId, level])
  @@index([requestId, createdAt])
  @@index([createdAt])
}

model Incident {
  recurringIssueId      String?
  recurringIssue        RecurringIssue?        @relation(fields: [recurringIssueId], references: [id])
  id                 String    @id @default(uuid())
  title              String
  description        String
  category           String
  location           String
  status             String    @default("OPEN")
  assignedDepartment String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  groupingReason     String?
  impactScore        Int?      @default(0)
  requests           Request[]

  @@index([impactScore])
  @@index([status])
  @@index([status, createdAt])
}

model MessFeedback {
  id        String   @id @default(uuid())
  menuId    String
  studentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id])
  menu      MessMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, studentId])
}

model MessMenu {
  id        String         @id @default(uuid())
  date      DateTime
  mealType  String
  items     String
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  feedbacks MessFeedback[]

  @@unique([date, mealType])
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  title       String
  message     String
  type        String
  readAt      DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())
  requestId   String?
  request     Request?  @relation(fields: [requestId], references: [id])
  recipient   User      @relation(fields: [recipientId], references: [id])

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model Policy {
  id                   String    @id @default(uuid())
  name                 String
  description          String?
  requestType          String?
  category             String?
  domain               String?
  approvalRequired     Boolean   @default(true)
  autoApproveCondition String?
  slaHours             Int?
  escalationPolicy     String?
  allowedTransitions   String?
  isActive             Boolean   @default(true)
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  requests             Request[]

  @@unique([name, version])
  @@index([isActive, updatedAt])
}

model Request {
  recurringIssueId      String?
  recurringIssue        RecurringIssue?        @relation(fields: [recurringIssueId], references: [id])
  id                  String                 @id @default(uuid())
  ticketNumber        String                 @unique
  requestType         String
  category            String
  requesterId         String
  description         String
  location            String?
  priority            String                 @default("LOW")
  status              String                 @default("PENDING")
  assignedDepartment  String?
  assignedAuthorityId String?
  SLA                 Int?
  dueAt               DateTime?
  incidentId          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  resolvedAt          DateTime?
  exitTime            DateTime?
  metadata            String?
  idempotencyKey      String?                @unique
  policyId            String?
  escalations         Escalation[]
  notifications       Notification[]
  policy              Policy?                @relation(fields: [policyId], references: [id])
  incident            Incident?              @relation(fields: [incidentId], references: [id])
  assignedAuthority   User?                  @relation("RequestAssignee", fields: [assignedAuthorityId], references: [id])
  requester           User                   @relation("RequestCreator", fields: [requesterId], references: [id])
  assignmentHistory   RequestAssignment[]
  requestSla          RequestSLA?
  statusHistory       RequestStatusHistory[]
  evidences           Evidence[]

  @@index([createdAt])
  @@index([dueAt, status])
  @@index([status])
  @@index([incidentId])
  @@index([assignedAuthorityId, status])
  @@index([requesterId, status])
  @@index([requesterId, updatedAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, resolvedAt])
}

model RequestAssignment {
  id           String    @id @default(uuid())
  requestId    String
  assigneeId   String
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  reason       String?
  assignee     User      @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  request      Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, assignedAt])
}

model RequestSLA {
  id          String    @id @default(uuid())
  requestId   String    @unique
  targetHours Int
  dueAt       DateTime
  warningAt   DateTime?
  breachedAt  DateTime?
  resolvedAt  DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
}

model RequestStatusHistory {
  id         String   @id @default(uuid())
  requestId  String
  fromStatus String?
  toStatus   String
  actorId    String?
  reason     String?
  createdAt  DateTime @default(now())
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Scholarship {
  id           String   @id @default(uuid())
  studentId    String   @unique
  academicYear String
  status       String
  updatedAt    DateTime @updatedAt
  student      User     @relation(fields: [studentId], references: [id])
}

model SmsOutbox {
  id            String    @id @default(uuid())
  recipientId   String?
  phoneNumber   String
  message       String
  status        String
  type          String
  referenceId   String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  failureReason String?
  recipient     User?     @relation(fields: [recipientId], references: [id])
}

model User {
  id                String                @id @default(uuid())
  email             String                @unique
  name              String
  role              String
  department        String?
  year              Int?
  branch            String?
  isResident        Boolean               @default(false)
  hostel            String?
  block             String?
  room              String?
  password          String?
  phone             String?
  announcements     Announcement[]        @relation("AnnouncementCreator")
  evidences         Evidence[]
  receipts          AnnouncementReceipt[]
  attendances       Attendance[]
  auditLogs         AuditLog[]
  courses           Course[]
  enrollments       Enrollment[]
  feedbacks         MessFeedback[]
  notifications     Notification[]
  requestsAssigned  Request[]             @relation("RequestAssignee")
  requestsCreated   Request[]             @relation("RequestCreator")
  assignmentHistory RequestAssignment[]
  scholarship       Scholarship?
  smsOutboxes       SmsOutbox[]
}

model Evidence {
  id          String   @id @default(uuid())
  requestId   String
  type        String // "IMAGE", "DOCUMENT", "TEXT_NOTE"
  description String?
  reference   String
  createdAt   DateTime @default(now())
  createdBy   String?
  creator     User?    @relation(fields: [createdBy], references: [id])
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}


model RecurringIssue {
  id              String     @id @default(uuid())
  category        String
  location        String
  occurrenceCount Int        @default(1)
  status          String     @default("ACTIVE")
  detectionReason String
  firstDetectedAt DateTime   @default(now())
  lastDetectedAt  DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  incidents       Incident[]
  requests        Request[]

  @@unique([category, location])
  @@index([status, lastDetectedAt])
}
