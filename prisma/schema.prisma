datasource db {
  provider = "sqlite"
  url      = "file:./campus.db"
}

generator client {
  provider = "prisma-client-js"
}

// User model for One Identity
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String?
  name           String
  role           String    // Student, Warden, Admin, Faculty, Staff
  department     String?
  year           Int?
  branch         String?
  isResident     Boolean   @default(false)
  hostel         String?
  block          String?
  room           String?

  // Relationships
  requestsCreated Request[] @relation("RequestCreator")
  requestsAssigned Request[] @relation("RequestAssignee")
  auditLogs       AuditLog[]
  scholarship     Scholarship?
}

model Request {
  id                 String    @id @default(uuid())
  ticketNumber       String    @unique
  requestType        String    // COMPLAINT, LEAVE, CERTIFICATE, etc.
  category           String
  requesterId        String
  requester          User      @relation("RequestCreator", fields: [requesterId], references: [id])
  description        String
  location           String?
  priority           String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status             String    @default("PENDING") // PENDING, ASSIGNED, ACKNOWLEDGED, PROCESSING, RESOLVED, VERIFIED, CLOSED, REJECTED
  assignedDepartment String?
  assignedAuthorityId String?
  assignedAuthority  User?     @relation("RequestAssignee", fields: [assignedAuthorityId], references: [id])
  SLA                Int?      // Hours
  dueAt              DateTime?
  incidentId         String?
  incident           Incident? @relation(fields: [incidentId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  exitTime           DateTime? // for leave/gate-pass metadata
  metadata           String?   // JSON string for attachments, custom fields, etc.
}

model Incident {
  id                 String    @id @default(uuid())
  title              String
  description        String
  category           String
  location           String
  status             String    @default("OPEN")
  assignedDepartment String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  
  requests           Request[]
}

model Scholarship {
  id                 String    @id @default(uuid())
  studentId          String    @unique
  student            User      @relation(fields: [studentId], references: [id])
  academicYear       String
  status             String    // ELIGIBLE, APPLIED, SUBMITTED, UNDER_VERIFICATION, APPROVED, SANCTIONED, DISBURSED, REJECTED, CANCELLED
  updatedAt          DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  action      String
  entity      String
  entityId    String
  timestamp   DateTime @default(now())
  metadata    String?  // JSON string
}
